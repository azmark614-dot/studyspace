<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Offline Notes</title>
  <!-- Simple Markdown Parser (Marked.js CDN - Optional fallback works offline once cached) -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <style>
    :root {
      --bg-primary: #f8f9fa;
      --bg-surface: #ffffff;
      --border-color: #e9ecef;
      --text-main: #212529;
      --text-muted: #6c757d;
      --accent-color: #0d6efd;
      --danger-color: #dc3545;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: var(--text-main);
      background-color: var(--bg-primary);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
      width: 320px;
      background: var(--bg-surface);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
    }

    .sidebar-header {
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .sidebar-actions {
      display: flex;
      gap: 0.5rem;
    }

    .btn {
      padding: 0.5rem 1rem;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: #fff;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--accent-color);
      color: white;
      border: none;
      flex: 1;
    }

    .btn-primary:hover { opacity: 0.9; }

    .search-bar {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      outline: none;
    }

    .notes-list {
      flex: 1;
      overflow-y: auto;
    }

    .note-item {
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
      cursor: pointer;
      transition: background 0.15s;
    }

    .note-item:hover, .note-item.active {
      background: #eef2ff;
    }

    .note-item-title {
      font-weight: 600;
      margin-bottom: 0.25rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .note-item-snippet {
      font-size: 0.85rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Main Editor */
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: var(--bg-surface);
    }

    .editor-header {
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .title-input {
      font-size: 1.5rem;
      font-weight: bold;
      border: none;
      outline: none;
      width: 70%;
    }

    .editor-container {
      flex: 1;
      display: flex;
      height: calc(100vh - 70px);
    }

    .editor-pane, .preview-pane {
      flex: 1;
      padding: 1.5rem;
      overflow-y: auto;
    }

    .editor-pane {
      border-right: 1px solid var(--border-color);
    }

    textarea.note-body {
      width: 100%;
      height: 100%;
      border: none;
      outline: none;
      resize: none;
      font-family: monospace;
      font-size: 1rem;
      line-height: 1.5;
    }

    .preview-pane {
      background: var(--bg-primary);
      line-height: 1.6;
    }

    .tags-input {
      border: none;
      outline: none;
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-top: 0.25rem;
      width: 100%;
    }

    .hidden-file-input { display: none; }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <div class="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-actions">
        <button class="btn btn-primary" onclick="createNewNote()">+ New Note</button>
        <button class="btn" onclick="exportData()" title="Backup Data">Export</button>
        <button class="btn" onclick="document.getElementById('importFile').click()" title="Restore Data">Import</button>
        <input type="file" id="importFile" class="hidden-file-input" accept=".json" onchange="importData(event)">
      </div>
      <input type="text" class="search-bar" id="searchInput" placeholder="Search notes..." oninput="renderNotesList()">
    </div>
    <div class="notes-list" id="notesList"></div>
  </div>

  <!-- Main Content View -->
  <div class="main-content">
    <div class="editor-header">
      <div style="flex: 1;">
        <input type="text" class="title-input" id="noteTitle" placeholder="Note Title" oninput="saveCurrentNote()">
        <input type="text" class="tags-input" id="noteTags" placeholder="Tags (comma separated)..." oninput="saveCurrentNote()">
      </div>
      <button class="btn" style="color: var(--danger-color);" onclick="deleteCurrentNote()">Delete</button>
    </div>
    <div class="editor-container">
      <div class="editor-pane">
        <textarea class="note-body" id="noteContent" placeholder="Start typing (Markdown supported)..." oninput="saveCurrentNote()"></textarea>
      </div>
      <div class="preview-pane" id="markdownPreview"></div>
    </div>
  </div>

